APP_URL=http://127.0.0.1:3000

# Leave empty to use the local Postgres-compatible database in .data/
# Production must set this to one Neon Postgres connection string.
# The app runs on Node. Cloudflare Workers cannot run the password hasher.
DATABASE_URL=

# Comma-separated verified emails that may open /admin. Not a role table.
ADMIN_EMAILS=

# Cloudflare account that will hold the WorldAsGame.com zone. Not an API token.
CLOUDFLARE_ACCOUNT_ID=

# Optional. Deferred on 2026-11-17: no sending key yet.
# Until both values exist, messages are stored in the admin mail log as "Not sent".
RESEND_API_KEY=
EMAIL_FROM=

# Public PayPal no-code checkout link. Paying here does not by itself unlock a story.
PAYPAL_PAYMENT_LINK=https://www.paypal.com/ncp/payment/PUMXJMAPDWRK6
